# Standalone application only; local backups and WordPress are excluded.
/*
!/.gitignore
!/.gitattributes
!/.htaccess
!/README.md
!/index.php
!/router.php
!/robots.txt
!/app/
!/assets/
!/content/
!/templates/
!/tests/
!/docs/
/assets/restored/
/assets/icons/
/assets/*.png
/assets/hero-dom-zubov*.webp
/content/pages/*
!/content/pages/index.html
!/content/pages/services.html
!/content/pages/services--*.html
!/content/pages/o-nas.html
!/content/pages/prices.html
!/content/pages/gift-certificates.html
!/content/pages/programma-blagodarnosti.html
!/content/pages/pravila-zapisi.html
!/content/pages/tax-deduction.html
